# ─────────────────────────────────────────────
# PLANEADOR ACADÉMICO — EJEMPLO DE CONFIGURACIÓN
# ─────────────────────────────────────────────
# Copia este archivo como .env y llena los valores
# cp .env.example .env

# Clave secreta de la app. OBLIGATORIA en produccion: firma las sesiones y
# deriva la clave que cifra las credenciales del colegio de cada profesor.
# Generala con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Si se deja vacia, la app arranca con el valor por defecto del repo publico
# y lo avisa en los logs.
SECRET_KEY=

# Clave de administrador: configura la API key y sirve de rescate en
# /api/admin/promover. Generala con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=

# API key de IA (opcional — también se puede configurar desde la app)
AI_API_KEY=
AI_PROVIDER=anthropic

# ── Solo para despliegue en servidor/Docker (Coolify) ──
# Carpeta donde se guardan perfiles.json, config.json, audit.log, mem_*.json
DATA_DIR=/data
# true en producción una vez haya HTTPS activo
SESSION_COOKIE_SECURE=false

# ── Cola de Chrome ──
# Cada planeación abre un Chromium headless de 400-700 MB. Este es el número
# que pueden correr a la vez; los demás profesores esperan turno y lo ven en
# pantalla. Regla práctica: 1 con 2 GB de RAM, 2 con 4 GB, 3 con 6 GB.
MAX_CHROMES=1
# Segundos de SILENCIO tras los que un turno se da por abandonado y se le
# cierra el Chrome. No es la duración máxima: cada mensaje de progreso lo
# renueva, así que una tanda larga nunca se corta sola.
TTL_TURNO=900
